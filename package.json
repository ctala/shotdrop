{
  "name": "shotdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Drop a screenshot, get a link that expires. Chrome extension + Cloudflare Worker on your own R2.",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "render": "node assets/src/render.mjs",
    "build": "sh scripts/build-zip.sh"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "wrangler": "^4.109.0"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
